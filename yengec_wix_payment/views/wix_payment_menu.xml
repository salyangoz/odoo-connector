<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_yengec_wix_payment_launch" model="ir.actions.server">
        <field name="name">Wix Payment Setup</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
        <field name="state">code</field>
        <field name="code">action = env.ref('yengec_connector.action_yengec_setup').with_context(yengec_integration='wix-payment').run()</field>
    </record>
    <menuitem
        id="menu_yengec_wix_payment_root"
        name="Wix Payment"
        sequence="135"
        groups="base.group_system"
        web_icon="yengec_wix_payment,static/description/icon.png"
        action="action_yengec_wix_payment_launch"
    />
</odoo>
