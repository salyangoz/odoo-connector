<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_yengec_ideasoft_launch" model="ir.actions.server">
        <field name="name">Ideasoft Setup</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = env.ref('yengec_connector.action_yengec_setup').with_context(yengec_integration='ideasoft').run()</field>
    </record>
    <menuitem
        id="menu_yengec_ideasoft_root"
        name="Ideasoft"
        sequence="107"
        web_icon="yengec_ideasoft,static/description/icon.png"
        action="action_yengec_ideasoft_launch"
    />
</odoo>
