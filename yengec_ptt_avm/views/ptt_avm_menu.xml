<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_yengec_ptt_avm_launch" model="ir.actions.server">
        <field name="name">PTT AVM Setup</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
        <field name="state">code</field>
        <field name="code">action = env.ref('yengec_connector.action_yengec_setup').with_context(yengec_integration='ptt-avm').run()</field>
    </record>
    <menuitem
        id="menu_yengec_ptt_avm_root"
        name="PTT AVM"
        sequence="111"
        groups="base.group_system"
        web_icon="yengec_ptt_avm,static/description/icon.png"
        action="action_yengec_ptt_avm_launch"
    />
</odoo>
