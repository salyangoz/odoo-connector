<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_yengec_amazon_global_launch" model="ir.actions.server">
        <field name="name">Amazon Seller Global Setup</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
        <field name="state">code</field>
        <field name="code">action = env.ref('yengec_connector.action_yengec_setup').with_context(yengec_integration='amazon-global').run()</field>
    </record>
    <menuitem
        id="menu_yengec_amazon_global_root"
        name="Amazon Seller Global"
        sequence="128"
        groups="base.group_system"
        web_icon="yengec_amazon_global,static/description/icon.png"
        action="action_yengec_amazon_global_launch"
    />
</odoo>
