<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_yengec_opencart_launch" model="ir.actions.server">
        <field name="name">OpenCart Setup</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
        <field name="state">code</field>
        <field name="code">action = env.ref('yengec_connector.action_yengec_setup').with_context(yengec_integration='opencart').run()</field>
    </record>
    <menuitem
        id="menu_yengec_opencart_root"
        name="OpenCart"
        sequence="138"
        groups="base.group_system"
        web_icon="yengec_opencart,static/description/icon.png"
        action="action_yengec_opencart_launch"
    />
</odoo>
