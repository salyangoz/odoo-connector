<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_yengec_beymen_launch" model="ir.actions.server">
        <field name="name">Beymen Setup</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = env.ref('yengec_connector.action_yengec_setup').with_context(yengec_integration='beymen').run()</field>
    </record>
    <menuitem
        id="menu_yengec_beymen_root"
        name="Beymen"
        sequence="116"
        web_icon="yengec_beymen,static/description/icon.png"
        action="action_yengec_beymen_launch"
    />
</odoo>
