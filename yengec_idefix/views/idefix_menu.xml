<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_yengec_idefix_launch" model="ir.actions.server">
        <field name="name">idefix Setup</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
        <field name="state">code</field>
        <field name="code">action = env.ref('yengec_connector.action_yengec_setup').with_context(yengec_integration='idefix').run()</field>
    </record>
    <menuitem
        id="menu_yengec_idefix_root"
        name="idefix"
        sequence="115"
        groups="base.group_system"
        web_icon="yengec_idefix,static/description/icon.png"
        action="action_yengec_idefix_launch"
    />
</odoo>
